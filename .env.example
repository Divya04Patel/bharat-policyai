# Local LLM Configuration (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=tinyllama
OLLAMA_TIMEOUT_SEC=25
OLLAMA_KEEP_ALIVE=15m
LLM_MAX_TOKENS=320

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000

# Embedding Configuration
# EMBEDDING_BACKEND options: "hash" (default, local) or "sentence-transformers" (requires pip install sentence-transformers)
EMBEDDING_BACKEND=hash
# EMBEDDING_MODEL is only used when EMBEDDING_BACKEND=sentence-transformers
# If using sentence-transformers, uncomment and customize:
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

HASH_EMBEDDING_DIM=384

# Data and Index Paths
DATA_DIR=data
# INDEX_DIR defaults to data/index if not set

# RAG Retrieval Configuration
MAX_CONTEXT_CHUNKS=4
RETRIEVAL_K=6
RETRIEVAL_MIN_SCORE=0.32

# Confidence thresholds for trust layer
CONFIDENCE_HIGH_THRESHOLD=0.78
CONFIDENCE_MEDIUM_THRESHOLD=0.55
